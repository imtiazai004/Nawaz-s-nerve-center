# Copy to .env and fill in. Never commit .env — see docs/05-stack.md.
#
# Nothing here is used yet: the domain core is pure logic with no database and no
# network. These are the values M0-02 onward will need.

NODE_ENV=development

# Postgres. Not provisioned yet — gated on Q-03 (who maintains this).
DATABASE_URL=postgres://user:password@localhost:5432/dnc_dev

# Server
PORT=3000
LOG_LEVEL=info

# Notification providers. Placeholders — real channels gated on Q-07.
# SMS_PROVIDER_KEY=
# WHATSAPP_PROVIDER_KEY=
